{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "nota",
	"version": "0.9.92-beta",
	"identifier": "app.nota.ink",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:8080",
		"beforeDevCommand": "bun run dev",
		"beforeBuildCommand": "bun run build"
	},
	"app": {
		"macOSPrivateApi": true,
		"windows": [
			{
				"title": "Nota",
				"width": 1280,
				"height": 720,
				"minHeight": 500,
				"minWidth": 800,
				"resizable": true,
				"fullscreen": false,
				"transparent": true,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"dragDropEnabled": false,
				"trafficLightPosition": {
					"x": 16,
					"y": 32
				},
				"windowEffects": {
					"effects": ["sidebar", "acrylic"]
				}
			}
		],
		"security": {
			"csp": "asset: http://asset.localhost",
			"assetProtocol": {
				"enable": true,
				"scope": ["**"]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"android": {
			"debugApplicationIdSuffix": ".debug"
		},
		"createUpdaterArtifacts": true
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDMkVBM0Y1MjBFMDBBODcKUldTSEN1QWc5YU11N0I5NmxIclFXWTlBc1dBR0cyKzdVSnV4N002TVgxKzNjb0Y4bkR1eHl6ek8K",
			"endpoints": [
				"https://github.com/Tsuzat/Nota/releases/latest/download/latest.json"
			]
		},
		"fs": {
			"requireLiteralLeadingDot": false
		},
		"deep-link": {
			"desktop": {
				"schemes": ["nota", "app.nota.ink"]
			}
		}
	}
}
