{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "deep-link:default",
    "dialog:default",
    "sql:default",
    "sql:allow-execute",
    "core:window:allow-start-dragging",
    "os:default",
    "core:window:allow-set-theme",
    "core:window:allow-theme"
  ]
}