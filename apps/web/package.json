{
  "name": "@nota/web",
  "private": true,
  "version": "0.0.7",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "wrangler types && vite build",
    "preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
    "prepare": "svelte-kit sync || echo ''",
    "check": "wrangler types --check && biome check . && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "gen": "wrangler types",
    "format": "biome format --write .",
    "lint": "biome check .",
    "ci": "biome ci"
  },
  "dependencies": {
    "@hocuspocus/provider": "^4.6.0",
    "@hocuspocus/transformer": "^4.6.0",
    "@nota/client": "workspace:*",
    "@nota/ui": "workspace:*",
    "@number-flow/svelte": "^0.4.2",
    "cookie": "0.6.0",
    "katex": "^0.18.4",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@vitest/browser-playwright": "^4.1.10",
    "motion-sv": "^0.1.13",
    "playwright": "^1.62.1",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vitest-browser-svelte": "^2.2.1",
    "wrangler": "^4.122.0"
  }
}
