{
	"name": "@nota/web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "bunx @biomejs/biome check --write .",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types",
		"lint": "bunx @biomejs/biome lint . && eslint .",
		"format": "bunx @biomejs/biome format --write .",
		"check:ci": "bunx @biomejs/biome check ."
	},
	"dependencies": {
		"@lucide/svelte": "catalog:",
		"@nota/api": "workspace:*",
		"@nota/env": "workspace:*",
		"@nota/ui": "workspace:*",
		"@number-flow/svelte": "^0.4.2",
		"@orpc/client": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/tanstack-query": "catalog:",
		"@polar-sh/better-auth": "catalog:",
		"@tanstack/svelte-form": "catalog:",
		"@tanstack/svelte-query": "catalog:",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"highlight.js": "^11.12.0",
		"katex": "^0.17.0",
		"mermaid": "^11.17.1",
		"motion-sv": "^0.1.13",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@nota/config": "workspace:*",
		"@sveltejs/adapter-cloudflare": "next",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tanstack/svelte-query-devtools": "catalog:",
		"@types/node": "^24.13.3",
		"eslint": "^10.9.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "^8.68.0",
		"vite": "catalog:",
		"wrangler": "^4.125.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#components": "./src/components/index.js",
		"#components/*": "./src/components/*"
	}
}
