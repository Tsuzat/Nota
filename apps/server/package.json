{
	"name": "@nota/server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs",
		"lint": "bunx @biomejs/biome lint .",
		"format": "bunx @biomejs/biome format --write .",
		"check": "bunx @biomejs/biome check --write .",
		"check:ci": "bunx @biomejs/biome check ."
	},
	"dependencies": {
		"@nota/ai": "workspace:*",
		"@nota/api": "workspace:*",
		"@nota/auth": "workspace:*",
		"@nota/cache": "workspace:*",
		"@nota/db": "workspace:*",
		"@nota/env": "workspace:*",
		"@nota/realtime": "workspace:*",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"hono": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@nota/config": "workspace:*",
		"@types/bun": "catalog:",
		"tsdown": "^0.22.14",
		"typescript": "catalog:"
	}
}
