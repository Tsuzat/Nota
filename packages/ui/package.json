{
	"name": "@nota/ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"svelte": "./src/lib/index.ts",
	"exports": {
		".": "./src/lib/index.ts",
		"./shadcn/*": "./src/lib/components/ui/*",
		"./custom/*": "./src/lib/components/custom/*",
		"./icons/*": "./src/lib/components/icons/*",
		"./edra/*": "./src/lib/components/edra/*",
		"./utils": "./src/lib/utils.ts",
		"./global.css": "./src/global.css",
		"./*": "./src/lib/*"
	},
	"scripts": {
		"build:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css",
		"build:components": "tsc",
		"dev:styles": "tailwindcss -i ./src/styles.css -o ./dist/index.css --watch",
		"dev:components": "tsc --watch",
		"lint": "bunx @biomejs/biome lint . && eslint .",
		"format": "bunx @biomejs/biome format --write .",
		"check": "bunx @biomejs/biome check --write .",
		"check:ci": "bunx @biomejs/biome check ."
	},
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.34.0",
		"@tanstack/svelte-virtual": "^3.13.35",
		"@tiptap/core": "^3.30.1",
		"@tiptap/extension-bubble-menu": "^3.30.1",
		"@tiptap/extension-code-block-lowlight": "^3.30.1",
		"@tiptap/extension-drag-handle": "^3.30.1",
		"@tiptap/extension-highlight": "^3.30.1",
		"@tiptap/extension-image": "^3.30.1",
		"@tiptap/extension-list": "^3.30.1",
		"@tiptap/extension-mathematics": "^3.30.1",
		"@tiptap/extension-subscript": "^3.30.1",
		"@tiptap/extension-superscript": "^3.30.1",
		"@tiptap/extension-table": "^3.30.1",
		"@tiptap/extension-table-of-contents": "^3.30.1",
		"@tiptap/extension-text-align": "^3.30.1",
		"@tiptap/extension-text-style": "^3.30.1",
		"@tiptap/extension-typography": "^3.30.1",
		"@tiptap/extension-unique-id": "^3.30.1",
		"@tiptap/extensions": "^3.30.1",
		"@tiptap/markdown": "^3.30.1",
		"@tiptap/pm": "^3.30.1",
		"@tiptap/starter-kit": "^3.30.1",
		"@tiptap/suggestion": "^3.30.1",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"katex": "^0.17.0",
		"lowlight": "^3.3.0",
		"mermaid": "^11.16.1",
		"mode-watcher": "^1.1.0",
		"svelte-sonner": "^1.1.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/dm-sans": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@sveltejs/adapter-auto": "next",
		"@sveltejs/kit": "next",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "catalog:",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"shadcn-svelte": "^1.5.0",
		"svelte": "catalog:",
		"svelte-check": "^4.6.0",
		"tailwindcss": "catalog:",
		"tw-animate-css": "^1.4.0",
		"typescript": "catalog:",
		"typescript-eslint": "^8.60.1",
		"vite": "catalog:"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
