{
	"name": "@nota/api",
	"type": "module",
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"lint": "bunx @biomejs/biome lint .",
		"format": "bunx @biomejs/biome format --write .",
		"check": "bunx @biomejs/biome check --write .",
		"check:ci": "bunx @biomejs/biome check ."
	},
	"dependencies": {
		"@nota/auth": "workspace:*",
		"@nota/cache": "workspace:*",
		"@nota/db": "workspace:*",
		"@nota/env": "workspace:*",
		"@orpc/client": "catalog:",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"dotenv": "catalog:",
		"nanoid": "^6.0.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@nota/config": "workspace:*",
		"hono": "catalog:",
		"typescript": "catalog:"
	}
}
