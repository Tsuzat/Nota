{
	"name": "@nota/auth",
	"type": "module",
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"auth:generate": "SKIP_ENV_VALIDATION=1 bunx --bun auth generate --config ./src/index.ts --output ../db/src/schema/auth.ts -y",
		"lint": "bunx @biomejs/biome lint .",
		"format": "bunx @biomejs/biome format --write .",
		"check": "bunx @biomejs/biome check --write .",
		"check:ci": "bunx @biomejs/biome check ."
	},
	"dependencies": {
		"@nota/db": "workspace:*",
		"@nota/email": "workspace:*",
		"@nota/env": "workspace:*",
		"@polar-sh/better-auth": "catalog:",
		"@polar-sh/sdk": "^0.49.0",
		"better-auth": "catalog:",
		"@better-auth/passkey": "catalog:",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@nota/config": "workspace:*",
		"typescript": "catalog:"
	}
}
